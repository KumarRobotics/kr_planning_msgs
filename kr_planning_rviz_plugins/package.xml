<?xml version="1.0"?>
<package format="3">
  <name>kr_planning_rviz_plugins</name>
  <version>0.1.0</version>
  <description>
    RViz 2 plugins for visualizing Kr Planning data structures and trajectories.
  </description>

  <license>Apache-2.0</license>

  <maintainer email="sikang@todo.todo">sikang</maintainer>
  <maintainer email="laurajar@seas.upenn.edu">Laura Jarin-Lipschitz</maintainer>
  <maintainer email="jiuzl@todo.todo">jiuzhou</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>rviz_default_plugins</depend>
  <depend>rviz_rendering</depend>
  <depend>pcl_ros</depend>
  <depend>kr_planning_msgs</depend>
  <depend>Eigen3</depend>
  <depend>tf2_eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>Boost</depend>
  <!-- <depend>OGRE</depend> -->
  

  <!-- Export plugin description for RViz 2 -->
  <export>
    <rviz_common plugin="kr_planning_rviz_plugins/plugin_description.xml"/>
    <build_type>ament_cmake</build_type>
  </export>
</package>